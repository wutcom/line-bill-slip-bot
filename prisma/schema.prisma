datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client_bot {
  provider = "prisma-client-js"
}

generator client_dashboard {
  provider = "prisma-client-js"
  output   = "../dashboard/node_modules/.prisma/client"
}

model AppUser {
  id             BigInt          @id @default(autoincrement())
  lineUserId     String          @unique @map("line_user_id")
  displayName    String?         @map("display_name")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  budgetPlans    BudgetPlan[]
  transactions   Transaction[]
  receiptFiles   ReceiptFile[]
  budgetPayments BudgetPayment[]
  bodyMetrics    BodyMetric[]

  @@map("app_users")
}

model Category {
  id           BigInt        @id @default(autoincrement())
  code         String        @unique
  name         String
  categoryType String        @default("expense") @map("category_type")
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  budgetPlans  BudgetPlan[]
  transactions Transaction[]

  @@map("categories")
}

model BudgetPlan {
  id             BigInt          @id @default(autoincrement())
  planId         String          @default(dbgenerated("gen_random_uuid()")) @map("plan_id") @db.Uuid
  userId         BigInt          @map("user_id")
  planMonth      DateTime        @map("plan_month") @db.Date
  planName       String          @map("plan_name")
  categoryId     BigInt?         @map("category_id")
  planAmount     Decimal         @default(0) @map("plan_amount") @db.Decimal(18, 2)
  status         String          @default("active")
  remark         String?
  sourceSheetRow Int?            @map("source_sheet_row")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  
  user           AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  budgetPayments BudgetPayment[]

  @@unique([userId, planMonth, planName], name: "unique_user_month_name")
  @@map("budget_plans")
}

model Transaction {
  id              BigInt        @id @default(autoincrement())
  transactionId   String        @default(dbgenerated("gen_random_uuid()")) @map("transaction_id") @db.Uuid
  userId          BigInt        @map("user_id")
  lineMessageId   String?       @map("line_message_id")
  documentType    String?       @map("document_type")
  expenseType     String        @default("expense") @map("expense_type")
  shopOrBankName  String?       @map("shop_or_bank_name")
  amount          Decimal       @default(0) @db.Decimal(18, 2)
  transactionDate DateTime?     @map("transaction_date") @db.Date
  referenceNo     String?       @map("reference_no")
  categoryId      BigInt?       @map("category_id")
  categoryText    String?       @map("category_text")
  description     String?
  rawText         String?       @map("raw_text")
  imageFileId     String?       @map("image_file_id")
  imageUrl        String?       @map("image_url")
  imageStoredAt   DateTime?     @map("image_stored_at") @db.Timestamptz
  ocrConfidence   Decimal?      @map("ocr_confidence") @db.Decimal(5, 4)
  status          String        @default("confirmed")
  sourceSheetRow  Int?          @map("source_sheet_row")
  sourceHash      String?       @map("source_hash")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt        DateTime?     @map("synced_at") @db.Timestamptz

  user            AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id])
  receiptFiles    ReceiptFile[]

  @@unique([userId, lineMessageId], name: "unique_user_message")
  @@map("transactions")
}

model ReceiptFile {
  id            BigInt       @id @default(autoincrement())
  userId        BigInt       @map("user_id")
  transactionId BigInt?      @map("transaction_id")
  lineMessageId String?      @map("line_message_id")
  driveFileId   String       @unique @map("drive_file_id")
  driveUrl      String?      @map("drive_url")
  fileName      String?      @map("file_name")
  mimeType      String?      @map("mime_type")
  fileSizeBytes BigInt?      @map("file_size_bytes")
  storedAt      DateTime     @default(now()) @map("stored_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user          AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@map("receipt_files")
}

model BudgetPayment {
  paymentId      String     @id @map("payment_id")
  userId         BigInt     @map("user_id")
  budgetPlanId   BigInt?    @map("budget_plan_id")
  planMonth      DateTime   @map("plan_month") @db.Date
  planName       String     @map("plan_name")
  amount         Decimal    @default(0) @db.Decimal(18, 2)
  paymentDate    DateTime?  @map("payment_date") @db.Date
  note           String?
  status         String     @default("active")
  sourceSheetRow Int?       @map("source_sheet_row")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt       DateTime?  @map("synced_at") @db.Timestamptz

  user           AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetPlan     BudgetPlan? @relation(fields: [budgetPlanId], references: [id])

  @@map("budget_payments")
}

model BodyMetric {
  id             BigInt    @id @default(autoincrement())
  userId         BigInt    @map("user_id")
  recordedDate   DateTime  @map("recorded_date") @db.Date
  weight         Decimal?  @db.Decimal(6, 2)
  height         Decimal?  @db.Decimal(6, 2)
  bmi            Decimal?  @db.Decimal(5, 2)
  bodyFatPct     Decimal?  @map("body_fat_pct") @db.Decimal(5, 2)
  muscleMass     Decimal?  @map("muscle_mass") @db.Decimal(6, 2)
  waist          Decimal?  @db.Decimal(6, 2)
  bpSystolic     Int?      @map("bp_systolic")
  bpDiastolic    Int?      @map("bp_diastolic")
  note           String?
  sourceSheetRow Int?      @map("source_sheet_row")
  sourceHash     String?   @map("source_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz

  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedDate], name: "body_metrics_unique_user_date")
  @@map("body_metrics")
}

model SyncRun {
  id            BigInt         @id @default(autoincrement())
  jobName       String         @map("job_name")
  startedAt     DateTime       @default(now()) @map("started_at") @db.Timestamptz
  finishedAt    DateTime?      @map("finished_at") @db.Timestamptz
  status        String         @default("running")
  rowsRead      Int            @default(0) @map("rows_read")
  rowsInserted  Int            @default(0) @map("rows_inserted")
  rowsUpdated   Int            @default(0) @map("rows_updated")
  errorMessage  String?        @map("error_message")
  metadata      Json?
  syncRowErrors SyncRowError[]

  @@map("sync_runs")
}

model SyncRowError {
  id           BigInt   @id @default(autoincrement())
  syncRunId    BigInt   @map("sync_run_id")
  sheetName    String   @map("sheet_name")
  sheetRow     Int?     @map("sheet_row")
  errorMessage String   @map("error_message")
  rawData      Json?    @map("raw_data")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  syncRun      SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@map("sync_row_errors")
}

model FoodLog {
  id                BigInt    @id @default(autoincrement())
  sourceRowId      String?   @unique @map("source_row_id")
  createdAt         DateTime? @map("created_at") @db.Timestamp
  messageId         String?   @map("message_id")
  userId            String?   @map("user_id")
  logDate           DateTime  @map("log_date") @db.Date
  mealName          String?   @map("meal_name")
  sourceType        String?   @map("source_type")
  detectedFood      String?   @map("detected_food")
  userPortionText   String?   @map("user_portion_text")
  estimatedKcal     Decimal?  @map("estimated_kcal") @db.Decimal(10, 2)
  estimatedKcalMin  Decimal?  @map("estimated_kcal_min") @db.Decimal(10, 2)
  estimatedKcalMax  Decimal?  @map("estimated_kcal_max") @db.Decimal(10, 2)
  proteinG          Decimal?  @map("protein_g") @db.Decimal(10, 2)
  proteinGoalG      Decimal?  @map("protein_goal_g") @db.Decimal(10, 2)
  carbG             Decimal?  @map("carb_g") @db.Decimal(10, 2)
  carbGoalG         Decimal?  @map("carb_goal_g") @db.Decimal(10, 2)
  fatG              Decimal?  @map("fat_g") @db.Decimal(10, 2)
  fatGoalG          Decimal?  @map("fat_goal_g") @db.Decimal(10, 2)
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(10, 2)
  waistInch         Decimal?  @map("waist_inch") @db.Decimal(10, 2)
  sugarLevel        String?   @map("sugar_level")
  sodiumLevel       String?   @map("sodium_level")
  confidence        Decimal?  @db.Decimal(5, 2)
  note              String?
  rawText           String?   @map("raw_text")
  source            String?   @default("google_sheet")
  syncedAt          DateTime? @default(now()) @map("synced_at") @db.Timestamp
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp

  @@map("food_logs")
}

